# Writes OUT, a C file defining dk_tools_stamp(): the sha256 over the names and contents of the C sources of the
# tools (core/ and lib/). The on-disk memos and the LTCG pin digest are versioned with it (the Python versioned them
# with the hash of its own source), so every executable built from the same sources shares them and a changed source
# invalidates them. Run by the build (add_custom_command in CMakeLists.txt); OUT is rewritten only when it changes.
file(GLOB_RECURSE files RELATIVE "${ROOT}" "${ROOT}/core/src/*" "${ROOT}/core/include/*" "${ROOT}/lib/*")
list(SORT files)
set(all "")
foreach(f IN LISTS files)
    file(SHA256 "${ROOT}/${f}" h)
    string(APPEND all "${f} ${h}\n")
endforeach()
string(SHA256 stamp "${all}")
set(text "/* Generated by ctools/cmake/tools_stamp.cmake: do not edit. */\nconst char *dk_tools_stamp(void);\nconst char *dk_tools_stamp(void) { return \"${stamp}\"; }\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
